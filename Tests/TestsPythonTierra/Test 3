import serial
import time
from matplotlib.figure import Figure
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from tkinter import *

# Abrir comunicacion con Arduino de tierra
device = 'COM3'
mySerial = serial.Serial(device, 9600, timeout=1)

# Variables
funcionando = False
temperaturas = []
eje_x = []

tiempo_inicio = time.time()
ultimo_latido = time.time()
alarma_latido = False


# Funcion para iniciar
def IniciarClick():
    global funcionando, temperaturas, eje_x
    global tiempo_inicio, ultimo_latido, alarma_latido

    if funcionando:
        return

    tiempo_inicio = time.time()
    temperaturas = []
    eje_x = []

    linea_grafica.set_data([], [])
    ax.set_xlim(0, 10)
    canvas.draw_idle()

    mySerial.reset_input_buffer()
    mySerial.write(b'INICIAR\n')

    ultimo_latido = time.time()
    alarma_latido = False
    funcionando = True


# Funcion para parar
def PararClick():
    global funcionando
    if not funcionando:
        return
    funcionando = False

    # Crear un espacio en blanco en la grafica
    eje_x.append(time.time() - tiempo_inicio)
    temperaturas.append(float('nan'))
    linea_grafica.set_data(eje_x, temperaturas)
    canvas.draw_idle()
    mySerial.write(b'PARAR\n')


# Funcion para reanudar
def ReanudarClick():
    global funcionando
    if funcionando:
        return
    mySerial.write(b'REANUDAR\n')
    funcionando = True


# Cambiar periodo de envio
def CambiarPeriodo():
    try:
        periodo = int(entrada_periodo.get())
        if periodo > 0:
            mensaje = "1:" + str(periodo) + "\n"
            mySerial.write(mensaje.encode('utf-8'))
        else:
            print("El periodo debe ser mayor que cero")

    except ValueError:
        print("Introduce un periodo valido")


# Cambiar orientacion del sensor
def CambiarOrientacion():
    try:
        orientacion = int(entrada_orientacion.get())
        if 0 <= orientacion <= 180:
            mensaje = "2:" + str(orientacion) + "\n"
            mySerial.write(mensaje.encode('utf-8'))
        else:
            print("La orientacion debe estar entre 0 y 180 grados")

    except ValueError:
        print("Introduce una orientacion valida")


# Funcion para recibir y procesar mensajes
def ActualizarGrafica():
    global funcionando, ultimo_latido, alarma_latido

    if mySerial.is_open and mySerial.in_waiting > 0:
        linea = mySerial.readline().decode('utf-8').strip()

        if linea != "":
            trozos = linea.split(':')
            codigo = trozos[0]

            # Temperatura y humedad
            if codigo == "1":
                if funcionando:
                    try:
                        temperatura = float(trozos[1])
                        humedad = float(trozos[2])
                        print("Temperatura:", temperatura, "Humedad:", humedad)

                        tiempo = time.time() - tiempo_inicio
                        temperaturas.append(temperatura)
                        eje_x.append(tiempo)

                        linea_grafica.set_data(eje_x, temperaturas)
                        if tiempo > 10:
                            ax.set_xlim(0, tiempo + 1)
                        else:
                            ax.set_xlim(0, 10)
                        canvas.draw_idle()

                    except (ValueError, IndexError):
                        print("Dato incorrecto:", linea)

            # Distancia
            elif codigo == "2":
                try:
                    distancia = float(trozos[1])
                    print("Distancia:", distancia)
                except (ValueError, IndexError):
                    print("Dato de distancia incorrecto:", linea)

            # Error de temperatura
            elif codigo == "3":
                print("Error al capturar temperatura o humedad")

            # Temperatura media
            elif codigo == "6":
                try:
                    media = float(trozos[1])
                    print("Temperatura media:", media)
                except (ValueError, IndexError):
                    print("Dato de temperatura media incorrecto:", linea)

            # Latido
            elif codigo == "5":
                ultimo_latido = time.time()
                alarma_latido = False

            # Error de distancia


            else:
                print("Mensaje desconocido:", linea)

    # Comprobar si se recibe el latido
    if time.time() - ultimo_latido > 5 and not alarma_latido:
        print("¡Alarma! No se recibe el latido")
        alarma_latido = True

    # Seguir comprobando aunque la grafica este parada
    window.after(20, ActualizarGrafica)


# Crear ventana principal
window = Tk()
window.geometry("700x700")

for fila in range(6):
    window.rowconfigure(fila, weight=1)

for columna in range(5):
    window.columnconfigure(columna, weight=1)


# Botones principales
IniciarButton = Button(window, text="Iniciar",
                       bg="#01f960", fg="black",
                       command=IniciarClick)
IniciarButton.grid(row=0, column=0, columnspan=5,
                   padx=5, pady=5, sticky=N+S+E+W)

PararButton = Button(window, text="Parar",
                     bg="#ff0095", fg="white",
                     command=PararClick)
PararButton.grid(row=1, column=0, columnspan=5,
                 padx=5, pady=5, sticky=N+S+E+W)

ReanudarButton = Button(window, text="Reanudar",
                        bg="#196ac7", fg="black",
                        command=ReanudarClick)
ReanudarButton.grid(row=2, column=0, columnspan=5,
                    padx=5, pady=5, sticky=N+S+E+W)


# Controles para cambiar el periodo
Label(window, text="Periodo (segundos):").grid(row=3, column=0)
entrada_periodo = Entry(window)
entrada_periodo.insert(0, "5")
entrada_periodo.grid(row=3, column=1)

PeriodoButton = Button(window, text="Cambiar periodo",
                       command=CambiarPeriodo)
PeriodoButton.grid(row=3, column=2, columnspan=3)


# Controles para cambiar la orientacion
Label(window, text="Orientacion (grados):").grid(row=4, column=0)
entrada_orientacion = Entry(window)
entrada_orientacion.insert(0, "90")
entrada_orientacion.grid(row=4, column=1)

OrientacionButton = Button(window, text="Cambiar orientacion",
                           command=CambiarOrientacion)
OrientacionButton.grid(row=4, column=2, columnspan=3)

# Crear figura y configurar ejes
fig = Figure(figsize=(6, 4))
ax = fig.add_subplot(111)

ax.set_xlabel("Tiempo (s)")
ax.set_ylabel("Temperatura (ºC)")
ax.set_ylim(0, 50)
ax.set_xlim(0, 10)
linea_grafica, = ax.plot([], [])

# Colocar grafica en la ventana
canvas = FigureCanvasTkAgg(fig, master=window)
canvas.get_tk_widget().grid(row=5, column=0, columnspan=5,
                            padx=5, pady=5, sticky=N+S+E+W)

window.after(20, ActualizarGrafica)
window.mainloop()
